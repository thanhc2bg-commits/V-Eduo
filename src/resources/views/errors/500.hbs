<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>500 Internal Server Error - EduSphere</title>

  <!-- Bootstrap 5 (local, offline-ready) -->
  <link href="/bootstrap/css/bootstrap.min.css" rel="stylesheet">

  <style>
    :root {
      --primary: #4f46e5;
      --primary-hover: #4338ca;
      --bg-color: #f3f4f6;
      --text-dark: #1e293b;
      --text-muted: #64748b;
    }

    body {
      background-color: var(--bg-color);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
      margin: 0;
      padding: 1rem;
    }

    .error-card {
      background: #ffffff;
      border-radius: 1.5rem;
      box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
      padding: 3.5rem 2rem;
      max-width: 600px;
      width: 100%;
      text-align: center;
    }

    .icon-wrapper {
      width: 100px;
      height: 100px;
      background-color: #fee2e2;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 1.5rem auto;
      color: #dc2626;
    }

    /* SVG Exclamation Triangle Icon */
    .icon-wrapper svg {
      width: 50px;
      height: 50px;
    }

    .error-code {
      font-size: 5.5rem;
      font-weight: 900;
      color: #dc2626;
      line-height: 1;
      letter-spacing: -0.05em;
      margin-bottom: 0.5rem;
      text-shadow: 2px 4px 10px rgba(220, 38, 38, 0.15);
    }

    .error-title {
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--text-dark);
      margin-bottom: 1rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .error-message {
      font-size: 1.1rem;
      color: var(--text-muted);
      margin-bottom: 2.5rem;
      line-height: 1.6;
    }

    .action-buttons {
      display: flex;
      gap: 1rem;
      justify-content: center;
      flex-wrap: wrap;
    }

    .btn-custom {
      padding: 0.75rem 2rem;
      border-radius: 50rem;
      font-weight: 600;
      transition: all 0.2s ease;
      text-decoration: none;
      cursor: pointer;
    }

    .btn-home {
      background-color: #dc2626;
      color: white;
      border: 2px solid #dc2626;
    }

    .btn-home:hover {
      background-color: #b91c1c;
      border-color: #b91c1c;
      color: white;
      transform: translateY(-2px);
      box-shadow: 0 10px 15px -3px rgba(220, 38, 38, 0.3);
    }

    .btn-back {
      background-color: white;
      color: var(--text-dark);
      border: 2px solid #cbd5e1;
    }

    .btn-back:hover {
      border-color: #dc2626;
      color: #dc2626;
      background-color: #f8fafc;
    }
  </style>
</head>
<body>

  <main class="error-card">
    
    <!-- Exclamation Triangle Icon -->
    <div class="icon-wrapper">
      <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16">
        <path d="M7.938 2.016A.13.13 0 0 1 8.002 2a.13.13 0 0 1 .063.016.146.146 0 0 1 .054.057l6.857 11.667c.036.06.035.124.002.183a.163.163 0 0 1-.054.06.116.116 0 0 1-.066.017H1.146a.115.115 0 0 1-.066-.017.163.163 0 0 1-.054-.06.176.176 0 0 1 .002-.183L7.884 2.073a.147.147 0 0 1 .054-.057zm1.044-.45a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566z"/>
        <path d="M7.002 12a1 1 0 1 1 2 0 1 1 0 0 1-2 0zM7.1 5.995a.905.905 0 1 1 1.8 0l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995z"/>
      </svg>
    </div>

    <div class="error-code">500</div>
    <div class="error-title">Lỗi máy chủ</div>

    <p class="error-message">
      {{error}}
    </p>

    <div class="action-buttons">
      <a href="/" class="btn-custom btn-home">Về trang chủ</a>
      <button onclick="history.back()" class="btn-custom btn-back">Quay lại</button>
    </div>

  </main>

</body>
</html>
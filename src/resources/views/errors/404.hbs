<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>404 — Không tìm thấy trang | V-Connect</title>

  <!-- Bootstrap 5 (local, offline-ready) -->
  <link href="/bootstrap/css/bootstrap.min.css" rel="stylesheet">

  <style>
    :root {
      --primary: #4f46e5;
      --primary-hover: #4338ca;
      --bg-color: #f3f4f6;
      --text-dark: #1e293b;
      --text-muted: #64748b;
    }

    body {
      background-color: var(--bg-color);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
      margin: 0;
      padding: 1rem;
    }

    .error-card {
      background: #ffffff;
      border-radius: 1.5rem;
      box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
      padding: 3.5rem 2rem;
      max-width: 600px;
      width: 100%;
      text-align: center;
    }

    .icon-wrapper {
      width: 100px;
      height: 100px;
      background-color: #e0e7ff;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 1.5rem auto;
      color: var(--primary);
    }

    /* SVG Magnifier Icon */
    .icon-wrapper svg {
      width: 50px;
      height: 50px;
    }

    .error-code {
      font-size: 5.5rem;
      font-weight: 900;
      color: var(--primary);
      line-height: 1;
      letter-spacing: -0.05em;
      margin-bottom: 0.5rem;
      text-shadow: 2px 4px 10px rgba(79, 70, 229, 0.15);
    }

    .error-title {
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--text-dark);
      margin-bottom: 1rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .error-message {
      font-size: 1.1rem;
      color: var(--text-muted);
      margin-bottom: 2.5rem;
      line-height: 1.6;
    }

    .action-buttons {
      display: flex;
      gap: 1rem;
      justify-content: center;
      flex-wrap: wrap;
    }

    .btn-custom {
      padding: 0.75rem 2rem;
      border-radius: 50rem;
      font-weight: 600;
      transition: all 0.2s ease;
      text-decoration: none;
      cursor: pointer;
    }

    .btn-home {
      background-color: var(--primary);
      color: white;
      border: 2px solid var(--primary);
    }

    .btn-home:hover {
      background-color: var(--primary-hover);
      border-color: var(--primary-hover);
      color: white;
      transform: translateY(-2px);
      box-shadow: 0 10px 15px -3px rgba(79, 70, 229, 0.3);
    }

    .btn-back {
      background-color: white;
      color: var(--text-dark);
      border: 2px solid #cbd5e1;
    }

    .btn-back:hover {
      border-color: var(--primary);
      color: var(--primary);
      background-color: #f8fafc;
    }
  </style>
</head>
<body>

  <main class="error-card">
    
    <!-- Magnifier Icon -->
    <div class="icon-wrapper">
      <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16">
        <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z"/>
      </svg>
    </div>

    <div class="error-code">404</div>
    <div class="error-title">Không tìm thấy trang</div>

    <p class="error-message">
      {{error}}
    </p>

    <div class="action-buttons">
      <a href="/" class="btn-custom btn-home">Về trang chủ</a>
      <button onclick="history.back()" class="btn-custom btn-back">Quay lại</button>
    </div>

  </main>

</body>
</html>

<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>403 Forbidden - EduSphere</title>

  <!-- Bootstrap 5 (local, offline-ready) -->
  <link href="/bootstrap/css/bootstrap.min.css" rel="stylesheet">

  <style>
    :root {
      --bs-primary: #4f46e5;
      --bs-primary-rgb: 79, 70, 229;
      --bs-body-font-family: system-ui, -apple-system, 'Segoe UI', Roboto,
        'Helvetica Neue', Arial, sans-serif;
    }
    body {
      background-color: #f8f9ff;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .error-icon {
      color: var(--bs-primary);
    }
    .role-badge {
      background-color: #e2dfff;
      color: #3323cc;
      border: 1px solid #c7c4d8;
    }
    .btn-outline-primary:hover {
      color: #fff;
    }
  </style>
</head>
<body>

  <main class="container text-center py-5" style="max-width: 640px;">

    <div class="mb-4">
      <!-- Shield-lock icon (SVG inline, offline) -->
      <svg class="error-icon" xmlns="http://www.w3.org/2000/svg" width="72" height="72" fill="currentColor" viewBox="0 0 16 16">
        <path d="M8 1a.5.5 0 0 1 .5.5V2h3.5a.5.5 0 0 1 .5.5v1.586l.354.354a.5.5 0 0 1 0 .707l-.354.354V7a.5.5 0 0 1-.5.5H8.5v1.5h.5a.5.5 0 0 1 .5.5v1.5h.5a.5.5 0 0 1 .5.5v1.5a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5v-1.5a.5.5 0 0 1 .5-.5h.5V10.5a.5.5 0 0 1 .5-.5h.5V9H2.5a.5.5 0 0 1-.5-.5V5.5a.5.5 0 0 1 .5-.5h.5V4.5a.5.5 0 0 1 .5-.5h.5V2.5a.5.5 0 0 1 .5-.5H7.5V1.5A.5.5 0 0 1 8 1z"/>
      </svg>
    </div>

    <h1 class="display-3 fw-bold text-dark mb-2">403</h1>
    <h2 class="fw-semibold mb-3">Không có quyền truy cập</h2>

    <p class="fs-5 text-muted mb-4">
      {{error}}
    </p>

    {{#if user}}
      <div class="d-inline-flex align-items-center gap-2 px-3 py-2 rounded-pill role-badge mb-4">
        <span class="small fw-medium text-secondary">Bạn đang đăng nhập với vai trò:</span>
        <span class="badge rounded-pill" style="background-color:#4f46e5;">{{user.role}}</span>
      </div>
    {{/if}}

    <div class="d-flex flex-column flex-sm-row gap-2 justify-content-center mt-2">
      <a href="/" class="btn btn-primary px-4 py-2 rounded-3">Về trang chủ</a>
      <button onclick="history.back()" class="btn btn-outline-primary px-4 py-2 rounded-3">Quay lại</button>
    </div>

  </main>

</body>
</html>
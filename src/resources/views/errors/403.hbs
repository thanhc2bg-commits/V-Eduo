<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>403 — Không có quyền truy cập | V-Connect</title>

  <!-- Bootstrap 5 (local, offline-ready) -->
  <link href="/bootstrap/css/bootstrap.min.css" rel="stylesheet">

  <style>
    :root {
      --primary: #4f46e5;
      --primary-hover: #4338ca;
      --bg-color: #f3f4f6;
      --text-dark: #1e293b;
      --text-muted: #64748b;
    }

    body {
      background-color: var(--bg-color);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
      margin: 0;
      padding: 1rem;
    }

    .error-card {
      background: #ffffff;
      border-radius: 1.5rem;
      box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
      padding: 3.5rem 2rem;
      max-width: 600px;
      width: 100%;
      text-align: center;
    }

    .icon-wrapper {
      width: 100px;
      height: 100px;
      background-color: #e0e7ff;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 1.5rem auto;
      color: var(--primary);
    }

    /* SVG Shield-Lock Icon */
    .icon-wrapper svg {
      width: 50px;
      height: 50px;
    }

    .error-code {
      font-size: 5.5rem;
      font-weight: 900;
      color: var(--primary);
      line-height: 1;
      letter-spacing: -0.05em;
      margin-bottom: 0.5rem;
      text-shadow: 2px 4px 10px rgba(79, 70, 229, 0.15);
    }

    .error-title {
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--text-dark);
      margin-bottom: 1rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .error-message {
      font-size: 1.1rem;
      color: var(--text-muted);
      margin-bottom: 2.5rem;
      line-height: 1.6;
    }

    .role-box {
      background-color: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 50rem;
      padding: 0.6rem 1.25rem;
      display: inline-flex;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 2.5rem;
    }

    .badge-role {
      background-color: var(--primary);
      color: white;
      padding: 0.35rem 1rem;
      border-radius: 50rem;
      font-weight: 600;
      font-size: 0.85rem;
      letter-spacing: 0.5px;
    }

    .action-buttons {
      display: flex;
      gap: 1rem;
      justify-content: center;
      flex-wrap: wrap;
    }

    .btn-custom {
      padding: 0.75rem 2rem;
      border-radius: 50rem;
      font-weight: 600;
      transition: all 0.2s ease;
      text-decoration: none;
      cursor: pointer;
    }

    .btn-home {
      background-color: var(--primary);
      color: white;
      border: 2px solid var(--primary);
    }

    .btn-home:hover {
      background-color: var(--primary-hover);
      border-color: var(--primary-hover);
      color: white;
      transform: translateY(-2px);
      box-shadow: 0 10px 15px -3px rgba(79, 70, 229, 0.3);
    }

    .btn-back {
      background-color: white;
      color: var(--text-dark);
      border: 2px solid #cbd5e1;
    }

    .btn-back:hover {
      border-color: var(--primary);
      color: var(--primary);
      background-color: #f8fafc;
    }
  </style>
</head>
<body>

  <main class="error-card">
    
    <!-- Shield Icon hiện đại hơn -->
    <div class="icon-wrapper">
      <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16">
        <path d="M5.338 1.59a61.44 61.44 0 0 0-2.837.856.481.481 0 0 0-.328.39c-.554 4.157.726 7.19 2.253 9.188a10.725 10.725 0 0 0 2.287 2.233c.346.244.652.42.893.533.12.057.218.095.293.118a.55.55 0 0 0 .101.025.615.615 0 0 0 .1-.025c.076-.023.174-.061.294-.118.24-.113.547-.29.893-.533a10.726 10.726 0 0 0 2.287-2.233c1.527-1.997 2.807-5.031 2.253-9.188a.48.48 0 0 0-.328-.39c-.651-.213-1.75-.56-2.837-.855C9.552 1.29 8.531 1.067 8 1.067c-.53 0-1.552.223-2.662.524zM5.072.56C6.157.265 7.31 0 8 0s1.843.265 2.928.56c1.11.3 2.229.655 2.887.87a1.54 1.54 0 0 1 1.044 1.262c.596 4.477-.787 7.795-2.465 9.99a11.775 11.775 0 0 1-2.517 2.453 7.159 7.159 0 0 1-1.048.625c-.28.132-.581.24-.829.24s-.548-.108-.829-.24a7.158 7.158 0 0 1-1.048-.625 11.777 11.777 0 0 1-2.517-2.453C1.928 10.487.545 7.169 1.141 2.692A1.54 1.54 0 0 1 2.185 1.43 62.456 62.456 0 0 1 5.072.56z"/>
        <path d="M9.5 6.5a1.5 1.5 0 0 1-1 1.415l.385 1.99a.5.5 0 0 1-.491.595h-.788a.5.5 0 0 1-.49-.595l.384-1.99a1.5 1.5 0 1 1 2-1.415z"/>
      </svg>
    </div>

    <div class="error-code">403</div>
    <div class="error-title">Không có quyền truy cập</div>

    <p class="error-message">
      {{error}}
    </p>

    {{#if user}}
      <div class="role-box">
        <span class="text-secondary small fw-medium">Bạn đang đăng nhập với vai trò:</span>
        <span class="badge-role">{{user.role}}</span>
      </div>
    {{/if}}

    <div class="action-buttons">
      <a href="/" class="btn-custom btn-home">Về trang chủ</a>
      <button onclick="history.back()" class="btn-custom btn-back">Quay lại</button>
    </div>

  </main>

</body>
</html>

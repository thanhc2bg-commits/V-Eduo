<meta name="csrf-token" content="{{csrfToken}}">

<div class="container py-3">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h2 class="fw-bold mb-1">Thêm khóa học mới</h2>
            <p class="text-muted small mb-0">Thêm khóa học đơn thủ công hoặc nhập danh sách từ Playlist YouTube</p>
        </div>
        <a href="/me/courses" class="btn btn-outline-secondary btn-sm">
            Khóa học của tôi
        </a>
    </div>

    <!-- Main Navigation Tabs -->
    <ul class="nav nav-pills mb-4 gap-2" id="createCourseTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active px-4 py-2 rounded-pill fw-medium" id="single-tab" data-bs-toggle="pill" data-bs-target="#single-course" type="button" role="tab">
                Thêm 1 khóa học
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link px-4 py-2 rounded-pill fw-medium" id="playlist-tab" data-bs-toggle="pill" data-bs-target="#playlist-course" type="button" role="tab">
                Nhập từ Playlist YouTube
            </button>
        </li>
    </ul>

    <div class="tab-content" id="createCourseTabContent">
        <!-- TAB 1: SINGLE COURSE FORM -->
        <div class="tab-pane fade show active" id="single-course" role="tabpanel">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-4">
                    <form action="/courses/store" method="POST">
                        <input type="hidden" name="_csrf" value="{{csrfToken}}">
                        
                        <div class="mb-3">
                            <label for="youtubeId" class="form-label fw-semibold">ID hoặc Link Video YouTube <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input type="text" class="form-control" id="youtubeId" name="youtubeId" placeholder="https://www.youtube.com/watch?v=... hoặc ID" required>
                                <button type="button" class="btn btn-outline-primary" id="btn-autofill">
                                    Tự điền thông tin
                                </button>
                            </div>
                            <div id="video-error" class="text-danger small mt-1"></div>
                            <div id="video-preview" class="mt-2"></div>
                        </div>

                        <div class="mb-3">
                            <label for="name" class="form-label fw-semibold">Tên khóa học <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="name" name="name" placeholder="Tên khóa học..." required>
                        </div>

                        <div class="mb-3">
                            <label for="description" class="form-label fw-semibold">Mô tả khóa học</label>
                            <textarea class="form-control" id="description" name="description" rows="3" placeholder="Mô tả tóm tắt nội dung khóa học..."></textarea>
                        </div>

                        <div class="mb-4">
                            <label for="level" class="form-label fw-semibold">Trình độ</label>
                            <select class="form-select" id="level" name="level">
                                <option value="Cơ bản">Cơ bản</option>
                                <option value="Trung bình">Trung bình</option>
                                <option value="Nâng cao">Nâng cao</option>
                            </select>
                        </div>

                        <div class="mb-4">
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input" id="certificate" name="certificate">
                                <label class="form-check-label" for="certificate">
                                    Cấp chứng chỉ khi học viên hoàn thành 100% khóa học
                                </label>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <a href="/me/courses" class="btn btn-light">Hủy</a>
                            <button type="submit" class="btn btn-primary px-4">Lưu khóa học</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

<!-- TAB 2: PLAYLIST IMPORT -->
        <div class="tab-pane fade" id="playlist-course" role="tabpanel">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-4">
                    <div class="mb-3">
                        <label for="playlist-input" class="form-label fw-semibold">Link hoặc ID Playlist YouTube <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <input type="text" class="form-control" id="playlist-input" placeholder="https://www.youtube.com/playlist?list=...">
                            <button type="button" class="btn btn-primary px-4" id="btn-fetch-playlist">
                                Lấy danh sách
                            </button>
                        </div>
                        <div id="playlist-error" class="text-danger small mt-1"></div>
                    </div>

                    <div id="playlist-preview" class="mt-3"></div>
                    <div id="playlist-progress" class="mt-3 text-primary small fw-medium"></div>
                    <div id="playlist-summary" class="mt-3"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="/js/youtube-autofill.js"></script>
<script src="/js/playlist-import.js"></script>

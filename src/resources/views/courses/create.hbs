<meta name="csrf-token" content="{{csrfToken}}">

<div class="mt-4">
    <h3>Đăng khóa học</h3>
    <form action="/courses/store" method="POST">
        <input type="hidden" name="_csrf" value="{{csrfToken}}">
        <div class="form-group">
            <label for="name">Tên khóa học</label>
            <input type="text" class="form-control" id="name" name="name" placeholder="Tên khóa học (có thể tự điền từ video)">
        </div>
        <div class="form-group">
            <label for="description">Mô tả</label>
            <input type="text" class="form-control" id="description" name="description">
        </div>
        <div class="form-group">
            <label for="videoid">ID Video</label>
            <div class="d-flex gap-2">
                <input type="text" class="form-control" id="videoid" name="videoid" placeholder="ID video hoặc link YouTube">
                <button type="button" class="btn btn-outline-primary" id="btn-autofill" style="white-space: nowrap;">Tự điền</button>
            </div>
            <!-- Thumbnail preview -->
            <div id="video-preview"></div>
            <!-- Thông báo lỗi -->
            <div id="video-error" class="text-danger small mt-1"></div>
        </div>
        <div class="form-group">
            <label for="level">Trình độ</label>
            <input type="text" class="form-control" id="level" name="level">
        </div>

        <button type="submit" class="btn btn-primary">Thêm khóa học</button>
    </form>
</div>

<hr class="my-5">

<div class="mt-4">
    <h3>Thêm nhiều video từ playlist</h3>
    <div class="form-group">
        <label for="playlist-input">Link hoặc ID playlist YouTube</label>
        <div class="d-flex gap-2">
            <input type="text" class="form-control" id="playlist-input" placeholder="https://www.youtube.com/playlist?list=PL... hoặc PL...">
            <button type="button" class="btn btn-outline-primary" id="btn-fetch-playlist" style="white-space: nowrap;">Lấy danh sách</button>
        </div>
        <div id="playlist-error" class="text-danger small mt-1"></div>
    </div>

    <div id="playlist-preview" class="mt-3"></div>

    <div id="playlist-progress" class="mt-3 text-primary small"></div>
    <div id="playlist-summary" class="mt-3"></div>
</div>

<script src="/js/youtube-autofill.js"></script>
<script src="/js/playlist-import.js"></script>

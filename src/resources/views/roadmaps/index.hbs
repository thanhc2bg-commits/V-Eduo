<div class="mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Lộ trình học tập</h2>
        <a href="/roadmaps/create" class="btn btn-primary">+ Tạo lộ trình</a>
    </div>
    <div class="row">
        {{#each roadmaps}}
        <div class="col-md-4 mb-3">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">{{this.name}}</h5>
                    <p class="card-text text-muted">{{this.description}}</p>
                    <a href="/roadmaps/{{this.slug}}" class="btn btn-outline-primary btn-sm">Xem</a>
                </div>
            </div>
        </div>
        {{else}}
        <p class="text-muted">Chưa có lộ trình nào.</p>
        {{/each}}
    </div>
</div>
<meta name="csrf-token" content="{{csrfToken}}">
<link rel="stylesheet" href="/css/roadmap-builder.css">

<div class="container mt-4">
    <div class="roadmap-builder-page">
        <div class="roadmap-builder-head">
            <h2>Update Learning Roadmap</h2>
            <p>Tuy chinh noi dung, trang thai xuat ban va thu tu khoa hoc trong lo trinh.</p>
        </div>

        <form action="/roadmaps/{{roadmap._id}}?_method=PUT" method="POST" class="roadmap-builder-grid mb-3">
            <input type="hidden" name="_csrf" value="{{csrfToken}}">

            <div class="rb-card">
                <h3>Roadmap Details</h3>

                <div class="mb-3">
                    <label class="rb-label" for="name">Roadmap Title</label>
                    <input type="text" class="form-control rb-control" id="name" name="name" value="{{roadmap.name}}" required>
                </div>

                <div class="mb-3">
                    <label class="rb-label" for="description">Description</label>
                    <textarea class="form-control rb-control" id="description" name="description" rows="4">{{roadmap.description}}</textarea>
                </div>

                <div class="rb-grid-2">
                    <div>
                        <label class="rb-label" for="category">Category</label>
                        <input type="text" class="form-control rb-control" id="category" name="category" value="{{roadmap.category}}" placeholder="Vi du: Computer Science">
                    </div>
                    <div>
                        <label class="rb-label" for="difficulty">Difficulty Level</label>
                        <input type="text" class="form-control rb-control" id="difficulty" name="difficulty" value="{{roadmap.difficulty}}" placeholder="Vi du: Beginner Friendly">
                    </div>
                </div>
            </div>

            <div class="d-grid gap-3">
                <div class="rb-card">
                    <h3>Publish Settings</h3>
                    <div class="rb-radio-group mb-2">
                        <label class="rb-radio">
                            <input type="radio" name="visibility" value="public" {{#if roadmap.visibility}}{{#if (eq roadmap.visibility 'public')}}checked{{/if}}{{else}}{{#if roadmap.isPublic}}checked{{/if}}{{/if}}>
                            <span><strong>Public</strong><span>Hien thi voi tat ca hoc vien.</span></span>
                        </label>
                        <label class="rb-radio">
                            <input type="radio" name="visibility" value="private" {{#if roadmap.visibility}}{{#if (eq roadmap.visibility 'private')}}checked{{/if}}{{else}}{{#unless roadmap.isPublic}}checked{{/unless}}{{/if}}>
                            <span><strong>Private</strong><span>Chi ai co lien ket moi xem duoc.</span></span>
                        </label>
                        <label class="rb-radio">
                            <input type="radio" name="visibility" value="draft" {{#if roadmap.visibility}}{{#if (eq roadmap.visibility 'draft')}}checked{{/if}}{{/if}}>
                            <span><strong>Draft</strong><span>Luu nhap, chua hien thi ra ngoai.</span></span>
                        </label>
                    </div>

                    <div>
                        {{#if (eq roadmap.visibility 'public')}}
                        <span class="rb-status-pill" data-type="public">Public</span>
                        {{/if}}
                        {{#if (eq roadmap.visibility 'private')}}
                        <span class="rb-status-pill" data-type="private">Private</span>
                        {{/if}}
                        {{#if (eq roadmap.visibility 'draft')}}
                        <span class="rb-status-pill" data-type="draft">Draft</span>
                        {{/if}}
                    </div>

                    <div class="rb-actions">
                        <button type="submit" class="rb-btn-primary">Save Roadmap Details</button>
                        <a href="/roadmaps/{{roadmap.slug}}" class="btn rb-btn-ghost">View Public Page</a>
                    </div>
                </div>

                <div class="rb-card">
                    <h3>Cover Image</h3>
                    <label class="rb-label" for="coverImage">Image URL</label>
                    <input type="url" class="form-control rb-control mb-2" id="coverImage" name="coverImage" value="{{roadmap.coverImage}}" placeholder="https://...">
                    <div class="rb-cover-preview" id="coverPreview">
                        {{#if roadmap.coverImage}}
                        <img src="{{roadmap.coverImage}}" alt="Cover preview">
                        {{else}}
                        <div class="rb-cover-empty">Preview anh bia se hien thi o day.</div>
                        {{/if}}
                    </div>
                </div>
            </div>
        </form>

        <form action="/roadmaps/{{roadmap._id}}/courses?_method=PUT" method="POST" class="rb-card mb-3" id="curriculumForm">
            <input type="hidden" name="_csrf" value="{{csrfToken}}">
            <div class="rb-section-head">
                <div>
                    <h4>Curriculum Builder</h4>
                    <p class="text-muted mb-0 small">Keo tha de doi thu tu. Chi cac muc duoc chon moi xuat hien trong roadmap.</p>
                </div>
                <button type="submit" class="btn rb-btn-primary">Save Curriculum</button>
            </div>

            {{#if courses.length}}
            <ul class="rb-curriculum-list" id="roadmapCourseList">
                {{#each courses}}
                <li class="rb-course-item" data-id="{{this._id}}">
                    <button type="button" class="rb-handle" aria-label="Drag to reorder">::</button>
                    <label class="mb-0 d-flex flex-column" for="course-{{this._id}}">
                        <span class="rb-course-name">{{this.name}}</span>
                        <span class="rb-course-meta">Khoa hoc ca nhan</span>
                    </label>
                    <input type="checkbox" class="form-check-input rb-course-check" name="courseIds" value="{{this._id}}" id="course-{{this._id}}" {{#if this.assigned}}checked{{/if}}>
                </li>
                {{/each}}
            </ul>
            {{else}}
            <div class="rb-empty">Ban chua co khoa hoc nao de them vao roadmap.</div>
            {{/if}}
        </form>

        <form action="/roadmaps/{{roadmap._id}}?_method=DELETE" method="POST" class="rb-card" onsubmit="return confirm('Xoa lo trinh nay?');">
            <input type="hidden" name="_csrf" value="{{csrfToken}}">
            <h3>Danger Zone</h3>
            <p class="text-muted mb-2">Hanh dong nay khong the hoan tac. Toan bo lien ket roadmap hien tai se bi xoa.</p>
            <button type="submit" class="btn rb-btn-danger">Delete This Roadmap</button>
        </form>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/Sortable/1.15.6/Sortable.min.js"></script>
<script>
    (function() {
        const coverInput = document.getElementById('coverImage');
        const preview = document.getElementById('coverPreview');

        function renderCover() {
            if (!coverInput || !preview) return;
            const value = (coverInput.value || '').trim();
            if (!value) {
                preview.innerHTML = '<div class="rb-cover-empty">Preview anh bia se hien thi o day.</div>';
                return;
            }
            preview.innerHTML = '<img src="' + value + '" alt="Cover preview" onerror="this.parentElement.innerHTML=\'<div class=\'rb-cover-empty\'>Khong the tai anh, hay kiem tra lai URL.</div>\'">';
        }

        if (coverInput) {
            coverInput.addEventListener('input', renderCover);
        }

        const list = document.getElementById('roadmapCourseList');
        if (list && window.Sortable) {
            Sortable.create(list, {
                animation: 150,
                handle: '.rb-handle',
            });
        }
    })();
</script>

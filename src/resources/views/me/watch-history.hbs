<div class="me-shell">
    <header class="me-head">
        <div class="me-head__copy">
            <span class="me-head__eyebrow">Hoạt động gần đây</span>
            <h1 class="me-head__title">Lịch sử xem</h1>
            <p class="me-head__desc">Các video bạn đã mở gần đây, sắp xếp theo thời gian.</p>
        </div>
        <div class="me-head__actions">
            <a href="/me/learning" class="me-btn me-btn--ghost">Khóa học đang học</a>
        </div>
    </header>

    {{#if grouped.length}}
        <div class="wh-days">
            {{#each grouped}}
            <section class="wh-day" aria-label="{{this.label}}">
                <h2 class="wh-day__label">{{this.label}}</h2>
                <div class="wh-list">
                    {{#each this.items}}
                        {{#if this.courseSlug}}
                        <a class="wh-item" href="/courses/{{this.courseSlug}}">
                        {{else}}
                        <div class="wh-item">
                        {{/if}}
                            <span class="wh-item__dot" aria-hidden="true"></span>
                            <span class="wh-item__main">
                                <span class="wh-item__title">{{this.title}}</span>
                                {{#if this.courseName}}
                                <span class="wh-item__course">Khóa: {{this.courseName}}</span>
                                {{/if}}
                            </span>
                            <span class="wh-item__date">{{formatDate this.createdAt}}</span>
                        {{#if this.courseSlug}}</a>{{else}}</div>{{/if}}
                    {{/each}}
                </div>
            </section>
            {{/each}}
        </div>

        {{#if pagination.hasMore}}
        <div class="wh-more">
            <a href="/me/watch-history?page={{sum pagination.page 1}}" class="me-btn me-btn--ghost">Xem thêm lịch sử</a>
        </div>
        {{/if}}
    {{else}}
        <div class="me-empty">
            <span class="me-empty__icon" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.91 11.672a.375.375 0 010 .656l-5.603 3.113a.375.375 0 01-.557-.328V8.887c0-.286.307-.466.557-.327l5.603 3.112z" />
                </svg>
            </span>
            <h2 class="me-empty__title">Bạn chưa xem video nào</h2>
            <p class="me-empty__subtitle">Lịch sử các video đã xem sẽ xuất hiện tại đây.</p>
            <a href="/courses" class="me-btn me-btn--primary">Khám phá khóa học</a>
        </div>
    {{/if}}
</div>

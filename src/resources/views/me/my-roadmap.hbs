<div class="me-shell">
    <header class="me-head">
        <div class="me-head__copy">
            <span class="me-head__eyebrow">Không gian sáng tạo</span>
            <h1 class="me-head__title">Lộ trình của tôi</h1>
            <p class="me-head__desc">Xây dựng lộ trình học tập theo từng bước và chia sẻ với người học.</p>
        </div>
        <div class="me-head__actions">
            <a href="/roadmaps/create" class="me-btn me-btn--primary">Tạo lộ trình</a>
        </div>
    </header>

    <div class="me-card">
        <div class="me-card__head">
            <span class="me-card__title">Danh sách lộ trình</span>
            <span class="me-card__count">{{roadmaps.length}} lộ trình</span>
        </div>
        <div class="me-table-wrap">
            <table class="me-table">
                <thead>
                    <tr>
                        <th scope="col">Tên lộ trình</th>
                        <th scope="col">Trạng thái</th>
                        <th scope="col" class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each roadmaps}}
                    <tr>
                        <td>
                            <a href="/roadmaps/{{this.slug}}" class="me-table__name">{{this.name}}</a>
                        </td>
                        <td>
                            {{#if this.status}}
                            <span class="me-badge {{this.status.cls}}">{{this.status.text}}</span>
                            {{else}}
                            <span class="me-badge me-badge--neutral">Riêng tư</span>
                            {{/if}}
                        </td>
                        <td>
                            <div class="me-table__actions me-table__actions--end">
                                <a href="/roadmaps/{{this._id}}/edit" class="me-btn me-btn--ghost me-btn--sm">Quản lý</a>
                                <button type="button" class="me-btn me-btn--danger-ghost me-btn--sm" data-bs-toggle="modal" data-bs-target="#delete-roadmap-modal" data-id="{{this._id}}" data-roadmap-name="{{this.name}}">Xóa</button>
                            </div>
                        </td>
                    </tr>
                    {{else}}
                    <tr>
                        <td colspan="3">
                            <div class="me-empty">
                                <span class="me-empty__icon" aria-hidden="true">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498l4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 00-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0z" />
                                    </svg>
                                </span>
                                <div class="me-empty__title">Chưa có lộ trình nào</div>
                                <div class="me-empty__subtitle">Hãy tạo lộ trình học tập đầu tiên của bạn.</div>
                                <a href="/roadmaps/create" class="me-btn me-btn--primary">Tạo lộ trình</a>
                            </div>
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal xác nhận xóa lộ trình (riêng cho trang roadmap) -->
<div class="modal fade" id="delete-roadmap-modal" tabindex="-1" aria-labelledby="delete-roadmap-modal-label" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content" style="border-radius: 1rem;">
            <div class="modal-header">
                <h5 class="modal-title" id="delete-roadmap-modal-label">Xóa lộ trình</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                Bạn có chắc chắn muốn xóa lộ trình "<span id="delete-roadmap-name"></span>" không? Các khóa học đang được gắn trong lộ trình sẽ được gỡ liên kết.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-soft" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-danger btn-soft" id="btn-delete-roadmap">Xóa</button>
            </div>
        </div>
    </div>
</div>

<!-- Hidden form để submit DELETE -->
<form id="delete-roadmap-form" method="POST">
    <input type="hidden" name="_csrf" value="{{csrfToken}}">
</form>

<!-- Toast container cho flash message -->
<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1100;">
    <div id="flashToast" class="toast align-items-center text-bg-success border-0" role="status" aria-live="polite" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body" id="flashToastBody"></div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Đóng"></button>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        // Hiển thị flash message từ query param (?updated=1)
        const params = new URLSearchParams(window.location.search);
        let flashMsg = null;
        if (params.get('updated')) flashMsg = 'Cập nhật lộ trình thành công!';
        if (flashMsg) {
            $('#flashToastBody').text(flashMsg);
            bootstrap.Toast.getOrCreateInstance(document.getElementById('flashToast')).show();
            // Xóa query param khỏi URL để không hiện lại khi refresh
            history.replaceState(null, '', window.location.pathname);
        }

        var roadmapId;

        // Khi modal hiển thị, lấy id + tên lộ trình từ nút Xóa được click
        $('#delete-roadmap-modal').on('show.bs.modal', function (event) {
            var button = $(event.relatedTarget);
            roadmapId = button.data('id');
            var roadmapName = button.data('roadmap-name');
            $('#delete-roadmap-name').text(roadmapName || '');
        });

        // Khi click nút Xóa trong modal, submit form DELETE
        $('#btn-delete-roadmap').on('click', function () {
            if (!roadmapId) return;
            $('#delete-roadmap-form')
                .attr('action', '/roadmaps/' + roadmapId + '?_method=DELETE')
                .trigger('submit');
        });
    });
</script>

<div class="me-shell">
    <header class="me-head">
        <div class="me-head__copy">
            <span class="me-head__eyebrow">Quản trị hệ thống</span>
            <h1 class="me-head__title">Khóa học của tôi</h1>
            <p class="me-head__desc">Toàn bộ khóa học trên nền tảng — quản lý nội dung và trạng thái xuất bản.</p>
        </div>
        <div class="me-head__actions">
            <a href="/courses/create" class="me-btn me-btn--primary">Thêm khóa học</a>
            <a href="/me/courses/trash" class="me-btn me-btn--danger-ghost">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
                </svg>
                Thùng rác
                {{#if deletedCount}}<span class="me-btn__count">{{deletedCount}}</span>{{/if}}
            </a>
        </div>
    </header>

    <div class="me-card">
        <div class="me-card__head">
            <span class="me-card__title">Tất cả khóa học</span>
            <span class="me-card__count">{{courses.length}} khóa học</span>
        </div>
        <div class="me-table-wrap">
            <table class="me-table">
                <thead>
                    <tr>
                        <th scope="col">Tên khóa học</th>
                        <th scope="col">Trình độ</th>
                        <th scope="col">Thời gian</th>
                        <th scope="col" class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each courses}}
                    <tr>
                        <td>
                            <a href="/courses/{{this.slug}}" class="me-table__name">{{this.name}}</a>
                        </td>
                        <td>
                            {{#if this.level}}
                            <span class="me-badge me-badge--neutral">{{this.level}}</span>
                            {{else}}
                            <span class="me-badge me-badge--neutral">Chưa cập nhật</span>
                            {{/if}}
                        </td>
                        <td class="me-table__muted">{{formatDate this.createdAt}}</td>
                        <td>
                            <div class="me-table__actions me-table__actions--end">
                                <a href="/courses/{{this._id}}/manage" class="me-btn me-btn--ghost me-btn--sm">Quản lý</a>
                                <a href="/courses/{{this._id}}/edit" class="me-btn me-btn--ghost me-btn--sm">Sửa</a>
                                <button type="button" class="me-btn me-btn--danger-ghost me-btn--sm" data-bs-toggle="modal" data-bs-target="#delete-course-modal" data-id="{{this._id}}" data-course-name="{{this.name}}">Xóa</button>
                            </div>
                        </td>
                    </tr>
                    {{else}}
                    <tr>
                        <td colspan="4">
                            <div class="me-empty">
                                <span class="me-empty__icon" aria-hidden="true">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
                                    </svg>
                                </span>
                                <div class="me-empty__title">Chưa có khóa học nào</div>
                                <div class="me-empty__subtitle">Hãy thêm khóa học đầu tiên của bạn để bắt đầu.</div>
                                <a href="/courses/create" class="me-btn me-btn--primary">Thêm khóa học</a>
                            </div>
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    </div>
</div>

{{> delete-modal}}

<script>
    $(document).ready(function() {
        // Hiển thị flash message từ query param (?created=1 / ?updated=1)
        const params = new URLSearchParams(window.location.search);
        let flashMsg = null;
        if (params.get('created')) flashMsg = 'Tạo khóa học thành công!';
        else if (params.get('updated')) flashMsg = 'Cập nhật khóa học thành công!';
        if (flashMsg) {
            $('#flashToastBody').text(flashMsg);
            bootstrap.Toast.getOrCreateInstance(document.getElementById('flashToast')).show();
            // Xóa query param khỏi URL để không hiện lại khi refresh
            history.replaceState(null, '', window.location.pathname);
        }

        var courseId;

        // Khi modal hiển thị, lấy id + tên khóa học từ nút Xóa được click
        $('#delete-course-modal').on('show.bs.modal', function(event) {
            var button = $(event.relatedTarget);
            courseId = button.data('id');
            var courseName = button.data('course-name');
            $('#delete-course-name').text(courseName || '');
        });

        // Khi click nút Xóa trong modal, submit form DELETE
        $('#btn-delete-course').on('click', function() {
            $('#delete-course-form').attr('action', '/courses/' + courseId + '?_method=DELETE');
            $('#delete-course-form').submit();
        });
    });
</script>
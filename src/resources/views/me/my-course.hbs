<link rel="stylesheet" href="/css/me-dashboard.css">
<div class="me-shell">
  <header class="me-header">
    <div>
      <span class="me-header__eyebrow">Workbench</span>
      <h1>Khóa học của tôi</h1>
      <p class="me-header__desc">Quản lý danh sách khóa học, cấu trúc bài học và thông tin xuất bản.</p>
    </div>
    <div class="me-header__actions">
      <a href="/courses/create" class="me-btn me-btn--primary">Thêm khóa học</a>
    </div>
  </header>
  <div class="me-card">
    <div class="me-table-wrap">
      <table class="me-table">
        <thead><tr><th>#</th><th>Tên khóa học</th><th>Trình độ</th><th>Ngày tạo</th><th class="text-end">Thao tác</th></tr></thead>
        <tbody>
          {{#each courses}}
          <tr>
            <td class="me-table__index">{{sum @index 1}}</td>
            <td><a href="/courses/{{this.slug}}" class="me-table__name">{{this.name}}</a></td>
            <td>{{#if this.level}}<span class="me-badge me-badge--neutral">{{this.level}}</span>{{else}}<span class="me-badge me-badge--neutral">Chưa cập nhật</span>{{/if}}</td>
            <td class="me-table__muted">{{formatDate this.createdAt}}</td>
            <td><div class="me-table__actions">
              <a href="/courses/{{this._id}}/manage" class="me-btn me-btn--ghost me-btn--sm">Quản lý</a>
              <a href="/courses/{{this._id}}/edit" class="me-btn me-btn--ghost me-btn--sm">Sửa</a>
              <button type="button" class="me-btn me-btn--danger-ghost me-btn--sm" data-bs-toggle="modal" data-bs-target="#delete-course-modal" data-id="{{this._id}}" data-course-name="{{this.name}}">Xóa</button>
            </div></td>
          </tr>
          {{else}}
          <tr><td colspan="5"><div class="me-empty">
            <div class="me-empty__icon">📚</div>
            <div class="me-empty__title">Chưa có khóa học nào</div>
            <div class="me-empty__subtitle">Hãy thêm khóa học đầu tiên của bạn để bắt đầu.</div>
            <a href="/courses/create" class="me-btn me-btn--primary me-btn--sm">Thêm khóa học</a>
          </div></td></tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </div>
</div>
{{> delete-modal}}
<script>
.ready(function(){
  var courseId;
  .on('show.bs.modal',function(e){var b=;courseId=b.data('id');.text(b.data('course-name')||'');});
  .on('click',function(){.attr('action','/courses/'+courseId+'?_method=DELETE');.submit();});
});
</script>
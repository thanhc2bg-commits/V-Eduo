<section class="auth-shell" aria-labelledby="register-title">
    <div class="auth-panel">
        <div class="auth-panel__intro">
            <span class="site-nav__logo" aria-hidden="true">V</span>
            <p class="auth-panel__eyebrow">Bắt đầu với V-Connect</p>
            <h1 id="register-title">Tạo một nơi học tập của riêng bạn.</h1>
            <p>Lưu tiến độ, ghi chú từng bài và xây dựng lộ trình phù hợp với mục tiêu.</p>
        </div>
        <div class="auth-card">
            <h2>Đăng ký</h2>

            {{#if error}}
            <div class="auth-alert" role="alert">{{error}}</div>
            {{/if}}

            <form method="POST" action="/auth/register">
                <input type="hidden" name="_csrf" value="{{csrfToken}}">
                <div class="auth-field">
                    <label for="name">Họ tên</label>
                    <input type="text" id="name" name="name"
                        value="{{name}}" required autofocus autocomplete="name">
                </div>
                <div class="auth-field">
                    <label for="username">Tên đăng nhập</label>
                    <input type="text" id="username" name="username"
                        value="{{username}}" required autocomplete="username">
                </div>
                <div class="auth-field">
                    <label for="email">Email</label>
                    <input type="email" id="email" name="email"
                        value="{{email}}" required autocomplete="email">
                </div>
                <div class="auth-field">
                    <label for="password">Mật khẩu <span>Tối thiểu 8 ký tự</span></label>
                    <input type="password" id="password" name="password"
                        required minlength="8" autocomplete="new-password">
                </div>
                <button type="submit" class="auth-submit">Tạo tài khoản</button>
            </form>

            <p class="auth-switch">
                Đã có tài khoản?
                <a href="/auth/login">Đăng nhập</a>
            </p>
        </div>
    </div>
</section>

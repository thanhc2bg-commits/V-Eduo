<section class="auth-shell" aria-labelledby="login-title">
    <div class="auth-panel">
        <div class="auth-panel__intro">
            <span class="site-nav__logo" aria-hidden="true">V</span>
            <p class="auth-panel__eyebrow">Chào mừng trở lại</p>
            <h1 id="login-title">Tiếp tục hành trình học của bạn.</h1>
            <p>Đăng nhập để mở khóa học đang học, ghi chú và tiến độ gần nhất.</p>
        </div>
        <div class="auth-card">
            <h2>Đăng nhập</h2>

            {{#if error}}
            <div class="auth-alert" role="alert">{{error}}</div>
            {{/if}}

            <form method="POST" action="/auth/login">
                <input type="hidden" name="_csrf" value="{{csrfToken}}">
                <input type="hidden" name="returnTo" value="{{returnTo}}">
                <div class="auth-field">
                    <label for="identifier">Tên đăng nhập hoặc email</label>
                    <input type="text" id="identifier" name="identifier" value="{{identifier}}" required autofocus autocomplete="username">
                </div>
                <div class="auth-field">
                    <label for="password">Mật khẩu</label>
                    <input type="password" id="password" name="password" required autocomplete="current-password">
                </div>
                <button type="submit" class="auth-submit">Đăng nhập</button>
            </form>

            <p class="auth-switch">
                Chưa có tài khoản?
                <a href="/auth/register">Đăng ký</a>
            </p>
        </div>
    </div>
</section>

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;700&family=Geist:wght@400;500&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Geist', Arial, sans-serif;
            background: #f5f3ef;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            padding: 24px;
        }
        .certificate {
            background: #fff;
            border: 2px solid #d4a853;
            padding: 48px 56px;
            max-width: 800px;
            width: 100%;
            text-align: center;
            position: relative;
            box-shadow: 0 12px 32px rgba(0,0,0,0.08);
        }
        .certificate::before,
        .certificate::after {
            content: '';
            position: absolute;
            width: 48px;
            height: 48px;
            border: 3px solid #d4a853;
        }
        .certificate::before { top: 12px; right: 12px; border-left: none; border-bottom: none; }
        .certificate::after { bottom: 12px; left: 12px; border-top: none; border-right: none; }
        .logo { font-size: 20px; letter-spacing: 4px; color: #b8860b; font-weight: 600; text-transform: uppercase; }
        .title {
            font-family: 'Playfair Display', serif;
            font-size: 38px;
            color: #1a1a1a;
            margin: 12px 0 20px;
            letter-spacing: 1px;
        }
        .subtitle { color: #777; font-size: 14px; margin-bottom: 30px; }
        .name {
            font-family: 'Playfair Display', serif;
            font-size: 30px;
            color: #2b5c8a;
            margin: 6px 0 10px;
            border-bottom: 1px solid #ddd;
            padding-bottom: 10px;
        }
        .course-name {
            font-size: 18px;
            color: #333;
            font-weight: 500;
            margin-top: 8px;
        }
        .date { color: #888; font-size: 14px; margin-top: 28px; }
        .cert-id {
            font-size: 12px;
            color: #aaa;
            margin-top: 8px;
            font-family: monospace;
        }
        .verify {
            margin-top: 28px;
            color: #999;
            font-size: 12px;
        }
        button {
            margin-top: 24px;
            padding: 10px 28px;
            border: 1px solid #d4a853;
            background: transparent;
            color: #b8860b;
            font-size: 14px;
            cursor: pointer;
            border-radius: 4px;
            transition: background .2s, color .2s;
        }
        button:hover { background: #d4a853; color: #fff; }
    </style>
</head>
<body>
    <div class="certificate">
        <div class="logo">V-Connect</div>
        <h1 class="title">Chứng chỉ hoàn thành</h1>
        <div class="subtitle">Chứng chỉ này được trao cho</div>
        <div class="name">{{userName}}</div>
        <div>đã hoàn thành xuất sắc khóa học</div>
        <div class="course-name">"{{courseName}}"</div>
        <div class="date">{{formatDate issuedAt}}</div>
        <div class="verify">Mã xác thực: <span class="cert-id">{{certificateId}}</span></div>
        <button onclick="window.print()">🖨 In chứng chỉ</button>
    </div>
</body>
</html>

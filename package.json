{
  "name": "v-connect",
  "version": "1.0.0",
  "description": "Nền tảng học trực tuyến V-Connect dành cho người học Việt Nam.",
  "keywords": [
    "nodejs",
    "education",
    "e-learning",
    "express"
  ],
  "homepage": "https://github.com/thanhc2bg-commits/V-Eduo#readme",
  "bugs": {
    "url": "https://github.com/thanhc2bg-commits/V-Eduo/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thanhc2bg-commits/V-Eduo.git"
  },
  "license": "ISC",
  "author": "phungdn",
  "type": "commonjs",
  "main": "src/index.js",
  "scripts": {
    "beautiful": "lint-staged",
    "build": "npm run build:css",
    "build:css": "sass --no-source-map --style=compressed src/resources/scss/app.scss src/public/css/app.css",
    "watch": "sass --watch --no-source-map src/resources/scss/app.scss:src/public/css/app.css",
    "dev": "nodemon --inspect src/index.js",
    "start": "node src/index.js",
    "test": "npm run build && node scripts/check-project.js",
    "create-admin": "node scripts/create-admin.js",
    "migrate-roadmap-v2": "node scripts/migrate-roadmap-v2.js",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.{js,css,scss}": "prettier --tab-width 4 --single-quote --trailing-comma all --write"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "bootstrap": "^5.3.8",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csrf-csrf": "^4.0.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-handlebars": "^9.0.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "method-override": "^3.0.0",
    "mongoose": "^9.9.1",
    "mongoose-delete": "^1.0.7"
  },
  "devDependencies": {
    "axios": "^1.19.0",
    "axios-cookiejar-support": "^7.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "morgan": "^1.11.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "sass": "^1.101.7",
    "tough-cookie": "^6.0.2"
  }
}

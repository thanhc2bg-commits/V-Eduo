# Server
PORT=3000

# Database
MONGODB_URI=mongodb://localhost:27017/V-connect-dev

# YouTube Data API v3 key (điền khi cần nâng cấp, để trống nếu dùng oEmbed)
YOUTUBE_API_KEY=

# JWT — bí mật ký ACCESS token (ngắn hạn 15 phút). Tạo bằng: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Refresh token KHÔNG phải JWT (chỉ là chuỗi random tra DB) nên không cần secret riêng.
JWT_SECRET=
JWT_EXPIRES_IN=15m

# CSRF — bí mật ký token chống CSRF. Tạo bằng: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
CSRF_SECRET=

# Admin đầu tiên (dùng với `npm run create-admin`)
ADMIN_NAME=Admin
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=